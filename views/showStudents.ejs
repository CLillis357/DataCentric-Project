<!DOCTYPE html>
<html>
<head>
    <title>Students</title>
    <style>
        table {
           
            border-collapse: collapse;
        }
        table, th, td {
            border: 1px solid black;
        }
        th, td {
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f2f2f2;
        }
        
    </style>
</head>
<body>
    <h1>Students</h1>
    <a href="/students/add">Add Student</a> | <a href="/">Home</a>
    <table>
        <tr>
            <th>Student ID</th>
            <th>Name</th>
            <th>Age</th>
            <th>Action</th>
        </tr>
        <% students.forEach(student => { %>
            <tr>
                <td><%= student.sid %></td>
                <td><%= student.name %></td>
                <td><%= student.age %></td>
                <td>
                    <a href="/students/edit/<%= student.sid %>">Update</a> | 
                    <a href="/students/delete/<%= student.sid %>">Delete</a>
                </td>
            </tr>
        <% }) %>
    </table>
</body>
</html>
