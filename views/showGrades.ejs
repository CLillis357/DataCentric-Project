<!DOCTYPE html>
<html>
<head>
    <title>Grades</title>
</head>
<style>
    table {
       
        border-collapse: collapse;
    }
    table, th, td {
        border: 1px solid black;
    }
    th, td {
        padding: 8px;
        text-align: left;
    }
    th {
        background-color: #f2f2f2;
    }
    
</style>
<body>
    <h1>Grades</h1>
    <a href="/">Home</a>
    <table>
        <tr>
            <th>Student Name</th>
            <th>Module</th>
            <th>Grade</th>
        </tr>
        <% grades.forEach(grade => { %>
            <tr>
                <td><%= grade.studentName %></td>
                <td><%= grade.moduleName || '' %></td>
                <td><%= grade.grade || '' %></td>
            </tr>
        <% }) %>
    </table>
</body>
</html>
