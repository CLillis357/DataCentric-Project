<!DOCTYPE html>
<html>
<head>
    <title>Lecturers</title>
</head>

<style>
    table {
       
        border-collapse: collapse;
    }
    table, th, td {
        border: 1px solid black;
    }
    th, td {
        padding: 8px;
        text-align: left;
    }
    th {
        background-color: #f2f2f2;
    }
    
</style>
<body>
    <h1>Lecturers</h1>
    <a href="/">Home</a>
    <table>
        <tr>
            <th>Lecturer ID</th>
            <th>Name</th>
            <th>Department</th>
            <th>Action</th>
        </tr>
        <% lecturers.forEach(lecturer => { %>
            <tr>
                <td><%= lecturer._id %></td>
                <td><%= lecturer.name %></td>
                <td><%= lecturer.did %></td>
                <td><a href="/lecturers/delete/<%= lecturer._id %>">Delete</a></td>
            </tr>
        <% }) %>
    </table>
</body>
</html>
